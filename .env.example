# Copy these into Vercel → Project → Settings → Environment Variables.
# For local runs with `vercel dev`, put them in .env (never committed).

# Shared secret the TV sends as ?token=… (any long random string:
# `openssl rand -hex 24`). Without it the API answers 401.
FEED_TOKEN=

# --- Calendar (same names and values as home-dashboard) ---------------------
# iCloud over CalDAV, with an app-specific password:
# appleid.apple.com > Sign-In and Security > App-Specific Passwords.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Optional: only these calendars (comma-separated names). Empty = all.
CALENDAR_NAMES=
# Calendars iCloud doesn't serve over CalDAV, as Name|link, comma-separated.
CALENDAR_ICS_URLS=

# --- Next up ----------------------------------------------------------------
HOME_TIMEZONE=Europe/Amsterdam
# From this hour, with nothing left today, tomorrow's first event is shown.
PREVIEW_HOUR=18
# show = online / no-location / at-home events get a card without travel;
# hide = they're skipped and the next real trip is shown instead.
NO_TRAVEL_CARD=show
# Short calendar locations → full addresses; "home" means no trip.
# Travel is only planned for events that have a location.
KNOWN_PLACES=Reshift=Nijverheidsweg 18, Haarlem;HvA=Wibautstraat, Amsterdam;Home|Thuis|WFH=home

# --- Travel -----------------------------------------------------------------
# Home is where trips start. HOME_LAT/HOME_LON (below) are used when set;
# otherwise HOME_ADDRESS is looked up with Google.
HOME_ADDRESS=
# Google Cloud key with the Geocoding API enabled (finds event addresses),
# plus the Routes API if you want routes without an NS key.
GOOGLE_MAPS_API_KEY=
# NS API portal key (Ns-App product): door-to-door routes with trains, buses,
# trams, metros and walks, including live delays and platforms. Without it,
# Google's Routes API plans the trip (no live delays).
NS_API_KEY=
# Arrive this many minutes before an event starts.
TRAVEL_BUFFER_MIN=5

# --- Weather (no keys needed) -----------------------------------------------
HOME_LAT=
HOME_LON=

# --- Parcels (emails to shipping@ → Postmark → /api/inbound) ---------------
# Secret for the inbound webhook URL: /api/inbound?token=INBOUND_TOKEN
# (a different random string from FEED_TOKEN).
INBOUND_TOKEN=
# Claude Console API key; reads each shipping email into a parcel.
ANTHROPIC_API_KEY=
# Optional model override.
ANTHROPIC_MODEL=claude-haiku-5-5
# Home postcode (e.g. 1234AB). Carriers want it for full tracking details.
HOME_POSTCODE=
# Other addresses you order for, as Label=postcode, e.g. Zus=1234AB.
# Their parcels show as "PostNL · for Zus · …"; OTHER_DELIVERIES=hide keeps
# them off the TV.
OTHER_ADDRESSES=
OTHER_DELIVERIES=show
# Optional: DHL "Shipment Tracking – Unified" key, so DHL parcels are confirmed
# and kept current by DHL itself.
DHL_API_KEY=
# Storage: add Upstash Redis from the Vercel Marketplace; it sets these
# (KV_REST_API_URL / KV_REST_API_TOKEN work too).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Launcher top shelf ----------------------------------------------------
# TMDB key (same as home-dashboard): what's popular per streaming service in NL.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# --- Screensaver photos -----------------------------------------------------
UNSPLASH_ACCESS_KEY=
UNSPLASH_COLLECTION_ID=
